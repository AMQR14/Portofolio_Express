# Copy to .env for local development. On Vercel, add these in
# Project -> Settings -> Environment Variables instead.

# Admin login (see README.md for how to generate these)
ADMIN_PASSWORD_HASH=
AUTH_SECRET=

# Exact URL of the frontend, no trailing slash
# local:  http://localhost:3001
# Vercel: https://your-frontend.vercel.app
FRONTEND_ORIGIN=http://localhost:3001

# Database
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=portofolio_db
DB_SSL=false

# Vercel Blob (added automatically when you connect a Blob store on Vercel).
# Leave empty locally to save uploads to ./uploads.
BLOB_READ_WRITE_TOKEN=
